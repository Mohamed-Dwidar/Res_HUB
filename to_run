-- 3.7b phone_key of every member (2026-10-18; Member::phoneKey(): digits only; an Egyptian mobile → its 10 digits), the same
--      key the app saves. Expected on account 1: 2,932 rows (the duplicates are merged in STEP 5c, after the imports)
--      A phone with several numbers (separated by / , ; |) = the key of the first one (2026-10-26: #2930 "01026126829 /
--      01550787727" = 22 digits, longer than phone_key varchar(20) → the import stopped here).
UPDATE members m
JOIN (SELECT id, REGEXP_REPLACE(SUBSTRING_INDEX(SUBSTRING_INDEX(SUBSTRING_INDEX(SUBSTRING_INDEX(phone, '/', 1), ',', 1), ';', 1), '|', 1), '[^0-9]', '') d
      FROM members) x ON x.id = m.id
SET m.phone_key = IF(REGEXP_LIKE(x.d, '^(0020|20|0)?1[0125][0-9]{8}$'), RIGHT(x.d, 10), x.d)
WHERE m.merged_into IS NULL;

