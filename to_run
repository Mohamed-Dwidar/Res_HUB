JOIN (SELECT x.id, CASE
    WHEN x.item IN ('تصوير', 'PAPER') THEN 1
    WHEN x.item IN ('شحن رصيد') THEN 2
    WHEN x.item IN ('ايصالات', 'ايصالات = 5', 'ايصالات حجوزات (4)', 'تحصيل لعمل ايصال') THEN 3
    WHEN x.item IN ('shared space', 'work space', 'روم', '150Room', 'روم من 11-12', 'Locker 10/11/12/1/2/3') THEN 5
    WHEN x.item IN ('بوفيه', 'pofee', 'poffe', 'حساب بوفيه', 'حساب البوفيه', 'عم امير بوفيه') THEN 101
    WHEN x.item IN ('عدد ساعات بريك') THEN 102
    WHEN x.item IN ('تقفيل الحساب بساعات اضافية') THEN 103
    WHEN x.item IN ('ترحيل حساب من الشهر اللي فات', 'ترحيل حساب من الشهر الحالى للشهر القادم', 'ترحيل الباكدج القديمة', 'ترحيل حساب من الشهر الماضي',
                    'حساب من الشهر القديم', 'ترحيل باكدج قديمة', 'حساب مرحل من الباكدج القديمة 10/2024', 'مرحل للباكدج الجديده (11/2024)',
                    'حساب باقى من باكدج قديمة', 'حساب قديم', 'حساب قديم من باكدج شهر 11', 'ترحيل من باكدج الشهر الفات',
                    'ترحيل حساب من الشهر اللي فات الى الشهر الحالى', 'ترحيل حساب من الشهر الى البكدج الجديدة', 'ترحيل حساب', 'old package',
                    'تقفيل حساب', 'تقفيل الباكدج', 'تقفيل حساب قديم', 'تصفير الحساب', 'تسويه', 'خصم', 'استرداد لدكتور محمد جمال من شركته') THEN 0
    ELSE -1 END category
  FROM dwidar_pivot_api.extras x) c ON c.id = e.id
WHERE c.category >= 0
  -- its package was deleted in the old system: skipped (user decision 2026-10-11)
  AND e.addable_id IN (SELECT id FROM dwidar_pivot_api.packages);
