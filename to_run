-- b) SQL, AFTER a): the periods still not renewed that ended more than 60 days before go-live → left (left_by 0 = auto, a manual
--    "Mark left" has the user id). Expected on 2026-10-14 (cutoff 2026-08-15): 227 marked, 14 stay under Not renewed.
SET @left_cutoff = CURDATE() - INTERVAL 60 DAY;
