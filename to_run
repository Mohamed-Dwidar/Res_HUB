--     a member deleted in the old system: kept as it is (no member, user decision); a package deleted in the old system: no package + Cancelled
INSERT INTO reservations (id, account_id, member_id, space_id, unit_id, plan_id, package_id, subscription_type_id, reservation_status_id,
  start_at, end_at, subscription_day, all_day, repeat_id, is_repeat, repeat_frequency, repeat_interval, number_of_peoples,
  amount, discount_percentage, discount_value, net_amount, paid_amount, remaining, notes, creatable_type, creatable_id,
  created_at, updated_at, deleted_at)
SELECT r.id, 1, r.member_id, r.space_id, r.unit_id, r.plan_id,
  -- a package deleted in the old system: no package, and the reservation is Cancelled (user decision 2026-10-11)
  IF(r.package_id > 0 AND r.package_id NOT IN (SELECT id FROM dwidar_pivot_api.packages), 0, COALESCE(r.package_id, 0)),
  COALESCE(r.subscription_id, 0),
  IF(r.is_cancelled = 1 OR (r.package_id > 0 AND r.package_id NOT IN (SELECT id FROM dwidar_pivot_api.packages)), 3, 2),
  r.date_from, r.date_to, COALESCE(r.subscription_day, 0), COALESCE(r.all_day, 0), COALESCE(r.repeat_id, 0), COALESCE(r.is_repeat, 0),
  IF(r.type_repeat IN ('daily', 'weekly', 'monthly', 'yearly'), r.type_repeat, NULL), 0, COALESCE(r.number_of_peoples, 1),
  ROUND(COALESCE(r.amount, 0), 2), 0, 0, ROUND(COALESCE(r.amount, 0), 2), 0, 0, r.notes,
  'Modules\\UserModule\\app\\Models\\User',
  CASE WHEN r.creatable_type LIKE '%UserModule%' AND r.creatable_id IN (SELECT id FROM dwidar_pivot_api.users) THEN r.creatable_id ELSE 1 END,
  r.created_at, r.updated_at, r.deleted_at
FROM dwidar_pivot_api.reservations r;

-- 3.9b no "continues" any more (user 2026-10-15; the app always saves an end date, a subscription is renewed by a new period;
--      reservations.is_continue dropped): a row without an end gets ONE period: the same length as the period it renews (renewal_of, the Renew rule), else its plan's lease period
--      (time based: hours; else days: day 1, week 7, month 30, year 365 — Plan::PERIOD_HOURS), ending 23:59:59 of its last day.
--      On 2026-10-15: 1 row without an end (#22115 → 14-11-2026 23:59:59, done); the old system has none.
UPDATE reservations r
JOIN plans p ON p.id = r.plan_id
LEFT JOIN reservations o ON o.id = r.renewal_of AND o.deleted_at IS NULL AND o.end_at IS NOT NULL
SET r.end_at = CASE
  WHEN p.is_time_based = 1 THEN r.start_at + INTERVAL CASE p.lease_period WHEN 'hour' THEN 1 WHEN 'day' THEN 24 WHEN 'week' THEN 168 WHEN 'year' THEN 8760 ELSE 720 END HOUR
  WHEN o.id IS NOT NULL THEN TIMESTAMP(DATE(r.start_at) + INTERVAL DATEDIFF(DATE(GREATEST(o.end_at, o.start_at)), DATE(o.start_at)) DAY, '23:59:59')
  ELSE TIMESTAMP(DATE(r.start_at) + INTERVAL CASE p.lease_period WHEN 'day' THEN 0 WHEN 'week' THEN 6 WHEN 'year' THEN 364 ELSE 29 END DAY, '23:59:59')
END
WHERE r.deleted_at IS NULL AND r.end_at IS NULL AND r.start_at IS NOT NULL;

