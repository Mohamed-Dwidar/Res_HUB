-- 3.15 imported payments + expenses of each old login = ONE closed "Imported from the old system" shift per login (every old employee
--      AND the account login 1) — else years of open shift. Only imported rows (id < 100001): app rows stay in the open shift.
--      closed_at = the LATER of its last payment / last expense (created_at); its "close" event at the same time (user 2026-10-14).
--      Re-runnable: it only adds a shift for a login without one and links what is still open. The totals (count, collected,
--      expenses, net per method) are set by STEP 5 `php artisan shifts:recalculate --imported` (the app's own code).
INSERT INTO shift_closings (account_id, user_id, first_payment_at, last_payment_at, count, cash_total, withholding_total, expenses_total,
  totals, notes, closed_by, closed_at, created_at, updated_at)
SELECT 1, x.user_id, MIN(x.first_at), MAX(x.last_at), 0, 0, 0, 0, NULL, 'Imported from the old system', 1, MAX(x.last_at), NOW(), NOW()
FROM (
  SELECT p.creatable_id user_id, MIN(p.created_at) first_at, MAX(p.created_at) last_at FROM payments p
  WHERE p.account_id = 1 AND p.id < 100001 AND p.deleted_at IS NULL AND p.shift_closing_id = 0 GROUP BY p.creatable_id
  UNION ALL
  SELECT e.creatable_id, MIN(e.created_at), MAX(e.created_at) FROM expenses e
  WHERE e.account_id = 1 AND e.id < 100001 AND e.deleted_at IS NULL AND e.shift_closing_id = 0 GROUP BY e.creatable_id
) x JOIN users u ON u.id = x.user_id
WHERE x.user_id NOT IN (SELECT user_id FROM shift_closings WHERE notes = 'Imported from the old system')
GROUP BY x.user_id;

UPDATE payments p
JOIN shift_closings s ON s.account_id = p.account_id AND s.user_id = p.creatable_id AND s.notes = 'Imported from the old system'
SET p.shift_closing_id = s.id
WHERE p.account_id = 1 AND p.id < 100001 AND p.deleted_at IS NULL AND p.shift_closing_id = 0;

UPDATE expenses e
JOIN shift_closings s ON s.account_id = e.account_id AND s.user_id = e.creatable_id AND s.notes = 'Imported from the old system'
SET e.shift_closing_id = s.id
WHERE e.account_id = 1 AND e.id < 100001 AND e.deleted_at IS NULL AND e.shift_closing_id = 0;

-- every imported shift: its span + closed_at from its payments AND expenses (the later last one)
UPDATE shift_closings s
JOIN (SELECT r.shift_closing_id, MIN(r.created_at) first_at, MAX(r.created_at) last_at FROM (
        SELECT shift_closing_id, created_at FROM payments WHERE deleted_at IS NULL AND shift_closing_id > 0
        UNION ALL SELECT shift_closing_id, created_at FROM expenses WHERE deleted_at IS NULL AND shift_closing_id > 0) r
      GROUP BY r.shift_closing_id) t ON t.shift_closing_id = s.id
SET s.first_payment_at = t.first_at, s.last_payment_at = t.last_at, s.closed_at = t.last_at
WHERE s.notes = 'Imported from the old system';

INSERT INTO shift_events (account_id, user_id, shift_closing_id, by_user_id, action, reason, totals, created_at)
SELECT s.account_id, s.user_id, s.id, 1, 'close', 'Imported from the old system', NULL, s.closed_at FROM shift_closings s
WHERE s.notes = 'Imported from the old system' AND s.id NOT IN (SELECT shift_closing_id FROM shift_events WHERE action = 'close');

UPDATE shift_events e JOIN shift_closings s ON s.id = e.shift_closing_id
SET e.created_at = s.closed_at
WHERE s.notes = 'Imported from the old system' AND e.action = 'close';

