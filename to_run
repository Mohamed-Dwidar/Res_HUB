UPDATE payments p
JOIN shift_closings s ON s.account_id = p.account_id AND s.user_id = p.creatable_id AND s.notes = 'Imported from the old system'
SET p.shift_closing_id = s.id
WHERE p.account_id = 1 AND p.id < 100001 AND p.deleted_at IS NULL AND p.shift_closing_id = 0 AND (p.created_at < @open_from OR p.paid_at < DATE(@open_from));

UPDATE expenses e
JOIN shift_closings s ON s.account_id = e.account_id AND s.user_id = e.creatable_id AND s.notes = 'Imported from the old system'
SET e.shift_closing_id = s.id
WHERE e.account_id = 1 AND e.id < 100001 AND e.deleted_at IS NULL AND e.shift_closing_id = 0 AND (e.created_at < @open_from OR e.spent_at < DATE(@open_from));

-- left open (the run's business day), per login: today's cash in / out of the old system (2026-10-26 run: payments 16: 8, 7: 3; expenses 16: 1, 1: 2, 7: 1)
SELECT 'payments' t, creatable_id login, COUNT(*) n FROM payments WHERE id < 100001 AND deleted_at IS NULL AND shift_closing_id = 0 GROUP BY creatable_id
UNION ALL SELECT 'expenses', creatable_id, COUNT(*) FROM expenses WHERE id < 100001 AND deleted_at IS NULL AND shift_closing_id = 0 GROUP BY creatable_id;

-- every imported shift: its span + closed_at from its payments AND expenses (the later last one)
UPDATE shift_closings s
JOIN (SELECT r.shift_closing_id, MIN(r.created_at) first_at, MAX(r.created_at) last_at FROM (
        SELECT shift_closing_id, created_at FROM payments WHERE deleted_at IS NULL AND shift_closing_id > 0
        UNION ALL SELECT shift_closing_id, created_at FROM expenses WHERE deleted_at IS NULL AND shift_closing_id > 0) r
      GROUP BY r.shift_closing_id) t ON t.shift_closing_id = s.id
SET s.first_payment_at = t.first_at, s.last_payment_at = t.last_at, s.closed_at = t.last_at
WHERE s.notes = 'Imported from the old system';

INSERT INTO shift_events (account_id, user_id, shift_closing_id, by_user_id, action, reason, totals, created_at)
SELECT s.account_id, s.user_id, s.id, 1, 'close', 'Imported from the old system', NULL, s.closed_at FROM shift_closings s
WHERE s.notes = 'Imported from the old system' AND s.id NOT IN (SELECT shift_closing_id FROM shift_events WHERE action = 'close');

UPDATE shift_events e JOIN shift_closings s ON s.id = e.shift_closing_id
SET e.created_at = s.closed_at
WHERE s.notes = 'Imported from the old system' AND e.action = 'close';
