-- 3.15 imported payments + expenses of each old login = ONE closed "Imported from the old system" shift per login (every old employee
--      AND the account login 1) — else years of open shift. Only imported rows (id < 100001): app rows stay in the open shift.
--      closed_at = the LATER of its last payment / last expense (created_at); its "close" event at the same time (user 2026-10-14).
--      Re-runnable: it only adds a shift for a login without one and links what is still open. The totals (count, collected,
--      expenses, net per method) are set by STEP 5 `php artisan shifts:recalculate --imported` (the app's own code).
--      The business day of the run stays OPEN (user 2026-10-26): rows ENTERED (created_at) since its start (today_hours_to − 24,
--      Pivot 02:00; before 02:00 = the day before) AND DATED that day (payments.paid_at / expenses.spent_at) are left in each
--      login's open shift, closed from My Shift in the app; a row entered today with an earlier date was earned then → closed.
SET @cut = (SELECT GREATEST(today_hours_to - 24, 0) FROM accounts WHERE id = 1);
SET @open_from = TIMESTAMP(DATE(NOW() - INTERVAL @cut HOUR)) + INTERVAL @cut HOUR;
SELECT @open_from open_shifts_from;
INSERT INTO shift_closings (account_id, user_id, first_payment_at, last_payment_at, count, cash_total, withholding_total, expenses_total,
  totals, notes, is_imported, closed_by, closed_at, created_at, updated_at)
SELECT 1, x.user_id, MIN(x.first_at), MAX(x.last_at), 0, 0, 0, 0, NULL, 'Imported from the old system', 1, 1, MAX(x.last_at), NOW(), NOW()
FROM (
  SELECT p.creatable_id user_id, MIN(p.created_at) first_at, MAX(p.created_at) last_at FROM payments p
  WHERE p.account_id = 1 AND p.id < 100001 AND p.deleted_at IS NULL AND p.shift_closing_id = 0 AND (p.created_at < @open_from OR p.paid_at < DATE(@open_from)) GROUP BY p.creatable_id
  UNION ALL
  SELECT e.creatable_id, MIN(e.created_at), MAX(e.created_at) FROM expenses e
  WHERE e.account_id = 1 AND e.id < 100001 AND e.deleted_at IS NULL AND e.shift_closing_id = 0 AND (e.created_at < @open_from OR e.spent_at < DATE(@open_from)) GROUP BY e.creatable_id
) x JOIN users u ON u.id = x.user_id
WHERE x.user_id NOT IN (SELECT user_id FROM shift_closings WHERE notes = 'Imported from the old system')
GROUP BY x.user_id;

-- the flag (2026-10-19) on imported closings made before it existed (the 2026-10-19 trial DB: 15); a fresh run: 0 (created flagged above).
-- Expected after 3.15 on the 2026-10-19 data: 15 imported closings (the account login 1 + 14 old users; old user 3 has no payment / expense)
UPDATE shift_closings SET is_imported = 1 WHERE notes = 'Imported from the old system' AND is_imported = 0;
